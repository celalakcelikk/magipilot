      "text": "<attachments>\n<attachment id=\"mail.hbs\">\n{{! filepath: {{WS}}/secrets/mail.hbs }}\n<p>SECRET_HBS_TOKEN</p>\n</attachment>\n<attachment id=\"zcreds.abap\">\n' filepath: {{WS}}/secrets/zcreds.abap\nDATA pw TYPE string VALUE 'SECRET_ABAP_PW'.\n</attachment>\n</attachments>\n<prompt>\nq2\n</prompt>"
